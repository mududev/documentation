{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Sarraf Pro Yardım",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": "/logo/sarraf-favicon.png",
  "navigation": {
    "languages": [
      {
        "language": "tr",
        "default": true,
        "groups": [
          {
            "group": "Başlangıç",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Günlük kullanım",
            "icon": "book-open",
            "pages": [
              "gunluk-kullanim/banka-akis"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/sarraf-light.svg",
    "dark": "/logo/sarraf-dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "href": "https://sarraf.pro/iletisim",
        "label": "Destek"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sarraf Pro",
      "href": "https://sarraf.pro"
    }
  },
  "contextual": {
    "options": []
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/sarrafpro",
      "instagram": "https://instagram.com/sarrafpro"
    },
    "links": [
      {
        "header": "Sarraf Pro",
        "items": [
          {
            "label": "Web sitesi",
            "href": "https://sarraf.pro"
          },
          {
            "label": "İletişim",
            "href": "https://sarraf.pro/iletisim"
          }
        ]
      }
    ]
  },
  "description": "Sarraf Pro günlük kullanım kılavuzları. Banka hareketlerini bulma, filtreler, durum işaretleri ve banka sorgularını adım adım öğrenin.",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0D101E"
    }
  },
  "search": {
    "prompt": "Kılavuzlarda ara..."
  },
  "seo": {
    "metatags": {
      "og:locale": "tr_TR"
    },
    "organization": {
      "name": "Sarraf Pro",
      "url": "https://sarraf.pro",
      "logo": "https://r2.backhub.pro/sarraf.svg"
    }
  },
  "fonts": {
    "family": "Lexend Deca"
  },
  "icons": {
    "library": "fontawesome"
  }
}
